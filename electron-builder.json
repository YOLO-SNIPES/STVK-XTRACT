
{
  "appId": "com.yolosnipes.stakxtract",
  "productName": "STAK-XTRACT",
  "directories": {
    "output": "electron-dist"
  },
  "files": [
    "dist/**/*",
    "electron-main.js",
    "package.json"
  ],
  "mac": {
    "category": "public.app-category.music",
    "target": "dmg"
  },
  "win": {
    "target": "nsis"
  },
  "linux": {
    "target": "AppImage"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
