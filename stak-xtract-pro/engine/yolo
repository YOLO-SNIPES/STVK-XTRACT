import os
for _v in ("ORT_DISABLE_TELEMETRY", "HF_HUB_DISABLE_TELEMETRY", "DISABLE_TELEMETRY", "DO_NOT_TRACK", "HF_HUB_DISABLE_UPDATE_CHECK"): os.environ.setdefault(_v, "1")  # no telemetry, anywhere
"""YOLO music utility CLI.
  yolo analyze <audio> [--transcribe]   analyze a track -> analyses/<name>.json
  yolo create --like <template> --bpm N --key "A min" --length M:SS [--out dir]
                                        generate MIDI starter + arrangement sketch
  yolo templates                        list arrangement templates
  yolo profile <name>                   show a track's learned style profile
"""
import sys, os, json, random

HERE = os.path.dirname(os.path.realpath(os.path.abspath(__file__)))
ROOT = os.path.dirname(HERE)
sys.path.insert(0, HERE)

MOODS = {
    "dark":      {"mode": "min", "drums": "halftime", "bass": "sub",    "density": 0.4},
    "driving":   {"mode": "min", "drums": "four",     "bass": "eighths","density": 0.7},
    "heavy":     {"mode": "min", "drums": "four",     "bass": "roots",  "density": 0.6},
    "glitchy":   {"mode": "min", "drums": "minimal",  "bass": "offbeat","density": 0.5},
    "rolling":   {"mode": "min", "drums": "dnb",      "bass": "eighths","density": 0.7},
    "trappy":    {"mode": "min", "drums": "trap",     "bass": "sub",    "density": 0.55},
    "open":      {"mode": "maj", "drums": "minimal",  "bass": "roots",  "density": 0.4},
    "euphoric":  {"mode": "maj", "drums": "four",     "bass": "offbeat","density": 0.75},
}

def parse_len(s):
    m, sec = s.split(":")
    return int(m) * 60 + int(sec)

def cmd_analyze(args):
    import subprocess
    src = args[0]
    name = os.path.splitext(os.path.basename(src))[0]
    os.makedirs(f"{ROOT}/analyses", exist_ok=True)
    # librosa/soundfile can't read compressed formats directly — convert first
    if not src.lower().endswith(".wav"):
        wav = f"{ROOT}/analyses/{name}.wav"
        print(f"converting to wav -> {wav}")
        subprocess.run(["ffmpeg", "-v", "quiet", "-y", "-i", src, "-ar", "22050", "-ac", "1", wav], check=True)
        src = wav
    feat = f"{ROOT}/analyses/{name}.features.json"
    print(f"extracting features -> {feat}")
    subprocess.run([f"{ROOT}/analyze/extract_features.py", src, feat], check=True)
    if "--transcribe" in args:
        tr = f"{ROOT}/analyses/{name}.transcript.json"
        print(f"transcribing -> {tr}")
        subprocess.run([f"{ROOT}/analyze/transcribe.py", src, tr, "tiny"], check=True)
    print("done.")

def cmd_templates(_args):
    import templates
    for t in templates.list_templates():
        tpl = templates.load_template(t)
        print(f"- {t}: {tpl.get('description','')} [{len(tpl['sections'])} sections]")

def cmd_profile(args):
    p = f"{ROOT}/style_profiles/{args[0]}.json"
    print(open(p).read() if os.path.exists(p) else f"no profile '{args[0]}' yet — analyze a track first.")

def cmd_create(args):
    import midi_gen, templates
    # parse flags
    f = dict(zip([a.lstrip('-') for a in args[::2]], args[1::2]))
    tpl_name = f.get("like", "artificial_instruments")
    key = f.get("key", "A min")
    root, mode = key.split()
    # NOTE_NAMES is sharps-only; accept flat spellings (Db = C#, Eb = D#, ...)
    # so the track's own key (Db) doesn't crash the creator.
    root = {"Db": "C#", "Eb": "D#", "Gb": "F#", "Ab": "G#", "Bb": "A#"}.get(root, root)
    mood = MOODS.get(f.get("mood", "dark"))
    # style profile first: it sets learned defaults (bpm etc.)
    _pp = f"{ROOT}/style_profiles/{tpl_name}.json"
    _prof = json.load(open(_pp)).get("generator_hints", {}) if os.path.exists(_pp) else {}
    bpm = float(f.get("bpm", _prof.get("bpm", 128)))
    total_s = parse_len(f.get("length", "4:00"))
    seed = int(f.get("seed", random.randrange(99999)))
    out = f.get("out", f"{ROOT}/output")
    os.makedirs(out, exist_ok=True)

    tpl = templates.load_template(tpl_name)
    # style profile (learned from analysis) overrides defaults when present
    prof_path = f"{ROOT}/style_profiles/{tpl_name}.json"
    profile = {}
    if os.path.exists(prof_path):
        with open(prof_path) as fh:
            profile = json.load(fh).get("generator_hints", {})
    from midi_gen import NOTE_NAMES
    def rel(semi):
        return NOTE_NAMES[(NOTE_NAMES.index(root)+semi)%12]
    # Degrees use the same semitone as their uppercase twin (iv = IV = 5 semitones;
    # quality comes from the progression tuple, not the case). {root+N} is N
    # semitones above the root, {rel_maj} is the relative major (+3).
    # Fixed 2026-11-06: album profiles use lowercase degrees ({iv}, {v}) and
    # root offsets ({root+2}, {root-2}); the old map crashed on those, so
    # 7 of the 14 INTERNALISM templates failed to generate.
    DEGREE = {"{root}":0,"{bII}":1,"{II}":2,"{bIII}":3,"{III}":4,"{IV}":5,
              "{bV}":6,"{V}":7,"{bVI}":8,"{VI}":9,"{bVII}":10,"{VII}":11,
              "{I}":0,"{i}":0,"{ii}":2,"{bii}":1,"{iii}":4,"{biii}":3,
              "{iv}":5,"{v}":7,"{bv}":6,"{vi}":9,"{bvii}":10,"{vii}":11,
              "{root+1}":1,"{root+2}":2,"{root+3}":3,"{root-1}":11,
              "{root-2}":10,"{root-3}":9,"{rel_maj}":3}
    def resolve(prog):
        out = []
        for r, q in prog:
            if r not in DEGREE:
                raise ValueError(f"unknown degree token {r!r} in progression {prog!r}")
            out.append((rel(DEGREE[r]), q))
        return out
    if "progression" in profile:
        prog = resolve(profile["progression"])
    elif mode == "min":
        prog = [(root,'min'),(rel(8),'maj'),(rel(3),'maj'),(rel(10),'maj')]
    else:
        prog = [(root,'maj'),('A','min'),('F','maj'),('G','maj')]
    # Profiles carry descriptive drum/bass notes ("unverified - no onset data...",
    # "D pedal (low)") that are not generator patterns; midi_gen silently
    # renders those as empty parts. Accept only real pattern names, else fall
    # back to the mood default so every template yields audible parts.
    drum_pat = profile.get("drums", mood["drums"])
    if drum_pat not in ("four", "halftime", "trap", "dnb", "minimal"):
        drum_pat = mood["drums"]
    bass_style = profile.get("bass", mood["bass"])
    if bass_style not in ("roots", "eighths", "offbeat", "sub"):
        bass_style = mood["bass"]

    secs = templates.apply_template(tpl, total_s)
    # unified length: all parts cover the full duration
    beats_total = total_s * bpm / 60
    bars_total = max(8, int(round(beats_total / 4)))
    n_chords = max(4, int(round(beats_total / 8)) + 1)  # 2 bars per chord
    full_prog = (prog * ((n_chords // len(prog)) + 1))[:n_chords]

    midi_gen.save(midi_gen.chords(full_prog, bpm, seed=seed), f"{out}/chords.mid")
    midi_gen.save(midi_gen.bassline(full_prog, bpm, style=bass_style, seed=seed), f"{out}/bass.mid")
    midi_gen.save(midi_gen.drums(drum_pat, bpm, bars=bars_total, seed=seed), f"{out}/drums.mid")
    midi_gen.save(midi_gen.melody(root, mode, bpm, bars=bars_total, density=mood["density"], seed=seed), f"{out}/melody.mid")

    sketch = templates.arrangement_sketch(tpl, total_s, bpm, key, prog, drum_pat)
    sketch += (f"\n\nSOUND DESIGN DIRECTION (from '{tpl_name}'):\n"
               f"- Low end carries the weight: sub-bass finale, dark peaks (brightness < 0.35 in climax)\n"
               f"- Contrast sections go bright and sparse (breakdown: energy 0.3, brightness 0.8)\n"
               f"- Arcs over loops: build across minutes, not bars. Resist the early drop.\n"
               f"- Seed: {seed} (reuse --seed {seed} to regenerate identically)")
    with open(f"{out}/arrangement.txt", "w") as fh:
        fh.write(sketch)
    print(f"wrote {out}/{{chords,bass,drums,melody}}.mid + arrangement.txt (seed {seed})")
    print()
    print(sketch)

def main():
    if len(sys.argv) < 2:
        print(__doc__); return
    cmd, args = sys.argv[1], sys.argv[2:]
    {"analyze": cmd_analyze, "create": cmd_create,
     "templates": cmd_templates, "profile": cmd_profile}[cmd](args)

if __name__ == "__main__":
    main()
